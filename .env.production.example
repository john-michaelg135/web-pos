# ============================================================
# web-pos — PRODUCTION environment variables (set these in Vercel)
# Copy each key into Vercel → Project → Settings → Environment Variables.
# Do NOT commit real secrets to Git.
# ============================================================

# next-auth: generate a NEW secret with `openssl rand -base64 32`
# Must be unique to POS — do not reuse another app's AUTH_SECRET.
AUTH_SECRET=

# This app's own public root URL (your deployed web-pos on Vercel). No trailing slash.
# Must EXACTLY match the root URL registered with the Auth Service owner.
# Example: https://web-pos.vercel.app
AUTH_URL=

# OIDC client assigned to POS (fixed by the auth guide).
AUTH_POS_CLIENT_ID=pos-client
# Secret provided by the Auth Service owner through a secure channel.
# Treat like a password. Never prefix with NEXT_PUBLIC_.
AUTH_POS_CLIENT_SECRET=

# Public HTTPS root of the Auth Service — FILL THIS IN when the auth team gives it.
# Must end with a trailing slash. Example: https://auth.example.com/
AUTH_ISSUER=

# Base URL the browser uses for API calls (usually this same web-pos origin,
# since /api-pos/* is proxied via next.config rewrites).
# Example: https://web-pos.vercel.app
NEXT_PUBLIC_API_URL=

# Where /api-pos/* rewrites to server-side: your deployed api-pos base URL, no trailing slash.
# Example: https://api-pos.onrender.com
API_POS_URL=

# Optional: only if apiAuth.ts is used directly. Deployed web-pos origin.
NEXT_PUBLIC_POS_URL=

# ============================================================
# Enterprise Portal single sign-on (server-side only; never prefix with NEXT_PUBLIC_)
# ============================================================
# Root URL of the Enterprise Portal. No trailing slash.
PORTAL_URL=https://br-auth-three.vercel.app
PORTAL_SYSTEM_NAME=POS
# Issued once by the Enterprise Portal when POS is registered. Treat like a password.
PORTAL_SYSTEM_SECRET=
# This app's own public root URL (required in production). Callback is {POS_APP_URL}/api/portal/callback.
# Example: https://web-pos-echoez.vercel.app (locally: https://localhost:3002)
POS_APP_URL=
# Development and tests ONLY: POS_DEV_BYPASS=true acts as a fully-permitted Staff member with no
# Enterprise Portal. POS refuses to start if it is set in production, on Vercel, or with a
# non-localhost POS_APP_URL. Never set it in a deployment.

# ============================================================
# SECURITY / PRODUCTION NOTES (per the br-auth integration guide)
# ------------------------------------------------------------
# - The local HTTPS dev flags in package.json's "dev" script
#   (NODE_EXTRA_CA_CERTS, --experimental-https, localhost.pem/localhost-key.pem,
#   certs/rootCA.pem) are DEV-ONLY. Vercel serves real TLS; the production
#   build (`next build` / `next start`) does not use them. Do not carry the
#   mkcert certs into the deployment.
# - Do NOT set NODE_TLS_REJECT_UNAUTHORIZED=0 in production. It is not needed
#   with a valid public certificate and is a security risk.
# - Do NOT create NEXT_PUBLIC_AUTH_POS_CLIENT_SECRET or NEXT_PUBLIC_AUTH_SECRET.
#   Client secrets must stay server-only.
# ============================================================

# ============================================================
# System switcher addresses (optional; these are the production defaults)
# ============================================================
# NEXT_PUBLIC_PORTAL_URL=https://br-auth-three.vercel.app
# NEXT_PUBLIC_CRM_URL=https://epic-crms.vercel.app
# NEXT_PUBLIC_HRM_URL=https://hrms-arae.vercel.app
# NEXT_PUBLIC_IMS_URL=https://br-sims.vercel.app
